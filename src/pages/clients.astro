---
// Clients et témoignages (requête : avis logiciel ostréicole). Aucune preuve inventée : témoignages,
// logos et étude de cas sont des emplacements à compléter (TODO-MANUEL.md).
import Base from '../layouts/Base.astro';
import EnTetePage from '../components/EnTetePage.astro';
import Temoignage from '../components/Temoignage.astro';
import ACompleter from '../components/ACompleter.astro';
import Photo from '../components/Photo.astro';
import AppelFinal from '../components/AppelFinal.astro';
import reglages from '../../site.config.mjs';
import { lien } from '../lib/chemins.mjs';
import { prechargePhoto } from '../lib/precharge.mjs';

const url = '/clients/';
const tailleHero = '(max-width: 720px) 67vw, 33vw';
const precharge = await prechargePhoto('tables-tremblade', tailleHero);
---
<Base
  titre="Clients et témoignages C’Claires"
  description="Une centaine d’ostréiculteurs, de mytiliculteurs et de mareyeurs travaillent avec C’Claires : leurs témoignages, leurs métiers et leurs façons d’expédier."
  url={url}
  enTete="accueil"
  precharges={[precharge]}
>
  <EnTetePage slot="avant" url={url} h1="Ils expédient avec C’Claires" couleur="noir" photos={['tables-tremblade', 'port-en-bessin', 'moules-saint-jacut']} tailleHero={tailleHero}
    sousTitre="Une centaine d’entreprises de la mer travaillent avec C’Claires : ostréiculteurs, mytiliculteurs et mareyeurs, de la claire au camion."
    actions={[{ href: lien('/demo/'), texte: 'Réserver une démo de 30 minutes', primaire: true }, { href: '#temoignages', texte: 'Lire leurs témoignages' }]} />

  <section id="temoignages" class="norms preuve" aria-labelledby="temoignages-titre">
    <div class="norms__board">
      <div class="norm norm--head" data-reveal>
        <h2 class="titre-long" id="temoignages-titre">Un client de chaque métier</h2>
        <p>Un ostréiculteur, un mytiliculteur et un mareyeur racontent comment partent leurs colis avec C’Claires.</p>
      </div>
      <Temoignage id="TEMO-01" metier="ostréiculteur" class="norm preuve__temoignage" />
      <Temoignage id="TEMO-02" metier="mytiliculteur" class="norm preuve__temoignage" />
      <Temoignage id="TEMO-03" metier="mareyeur" class="norm preuve__temoignage" />
      <div class="norm preuve__logos">
        <ACompleter id="LOGOS-01" texte="logos de 6 à 8 clients qui ont donné leur accord, en SVG d’une seule couleur, à poser sur ces tuiles" />
      </div>
    </div>
  </section>

  <section id="etude-de-cas" class="benefices" aria-labelledby="cas-titre">
    <h2 class="benefices__titre titre-long" id="cas-titre" data-reveal>Une exploitation, avant et après C’Claires</h2>
    <ACompleter id="CAS-01" class="cas"
      texte="étude de cas chiffrée d’un client qui a donné son accord : entreprise, métier et bassin, situation de départ, mise en place, résultats mesurés (temps de préparation, erreurs d’étiquetage, délai de facturation…), chiffres vérifiables uniquement, citation du dirigeant" />
  </section>

  <section class="aussi" aria-labelledby="temoigner-titre">
    <figure class="aussi__photo" data-reveal>
      <Photo nom="parcs-moules-saint-jacut" sizes="(max-width: 1080px) 100vw, 60vw" alt="Parcs à moules sur bouchots à marée basse vers Saint-Jacut-de-la-Mer, un bateau de mytiliculteur entre les rangées" />
      <figcaption>Parcs à moules sur bouchots, baie de l’Arguenon, à marée basse.</figcaption>
    </figure>
    <h2 class="aussi__titre titre-long" id="temoigner-titre" data-reveal>Vous êtes client et vous voulez témoigner&#8239;?</h2>
    <p class="aussi__suite" data-reveal>Écrivez-nous à <a class="link" href={`mailto:${reglages.email}`}>{reglages.email}</a> : nous préparons le texte avec vous, et rien n’est publié sans votre accord écrit.</p>
  </section>

  <AppelFinal titre="Montrez-nous comment partent vos colis" texte="En 30 minutes, nous vous montrons le parcours d’une commande avec vos articles et vos clients." />
</Base>
