---
// Toutes les fonctionnalités : les sept pages en lignes d’affiche, ce que comprend encore l’abonnement,
// et le renvoi vers la feuille de route pour ce qui arrive (règle 1 : rien d’annoncé ici).
import Base from '../../layouts/Base.astro';
import EnTetePage from '../../components/EnTetePage.astro';
import AppelFinal from '../../components/AppelFinal.astro';
import Photo from '../../components/Photo.astro';
import { groupe } from '../../donnees/plan.mjs';
import { lien } from '../../lib/chemins.mjs';
import { prechargePhoto } from '../../lib/precharge.mjs';

const url = '/fonctionnalites/';
const noms: Record<string, string> = {
  '/fonctionnalites/commandes-bons-de-livraison/': 'Commandes et BL',
  '/fonctionnalites/etiquette-sanitaire/': 'Étiquettes',
  '/fonctionnalites/palettisation-sscc/': 'Palettes et SSCC',
  '/fonctionnalites/tracabilite/': 'Traçabilité',
  '/fonctionnalites/parcs-claires/': 'Parcs et claires',
  '/fonctionnalites/edi-grande-distribution/': 'EDI',
  '/fonctionnalites/facture-electronique/': 'Facture électronique',
};
const fonctions = groupe('fonctionnalites');
const aussi = [
  ['Approvisionnement', 'Achats, réceptions et mise en stock par lot, origine comprise.'],
  ['Poids variable', 'Le poids estimé à la commande, puis le poids réel de la pesée.'],
  ['Viviers', 'Stock en vrac, en poids fixe ou emballé, et en poids variable.'],
  ['Éditeur d’étiquettes', 'Intégré, avec les codes-barres 1D et 2D : EAN-13, GS1-128, Code 128, QR code, DataMatrix.'],
  ['Plusieurs étiqueteuses', 'Une impression répartie sur plusieurs étiqueteuses à la fois, et chaque réimpression au journal.'],
  ['Port et facturation', 'Le port calculé à chaque BL, les factures au rythme de chaque client.'],
  ['Export comptable', 'Les écritures exportées au format de votre logiciel comptable.'],
  ['Installation', 'Postes Windows ou serveur TSE, au choix, et des données hébergées en France.'],
];
const tailleHero = '(max-width: 720px) 67vw, 33vw';
const precharge = await prechargePhoto('tables-seudre', tailleHero);
---
<Base
  titre="Fonctionnalités du logiciel C’Claires"
  description="Toutes les fonctions du logiciel C’Claires : commandes et BL, étiquettes sanitaires, palettes SSCC, traçabilité, parcs et claires, EDI, factures. Sans option."
  url={url}
  enTete="accueil"
  precharges={[precharge]}
>
  <EnTetePage slot="avant" url={url} h1="Tout ce que fait C’Claires, sans module en option" couleur="paon" photos={['tables-seudre', 'sillons-vasiere', 'moules-saint-jacut']} tailleHero={tailleHero}
    accroche={['Tout', 'compris']}
    sousTitre="Commandes, lots, étiquettes, palettes, traçabilité, parcs et factures : tout est dans l’abonnement. Et chaque fonction reprend ce que la précédente a saisi, alors rien ne se tape deux fois."
    actions={[{ href: lien('/demo/'), texte: 'Réserver ma démo de 30 minutes', primaire: true }, { href: '#fonctions', texte: 'Voir les sept fonctions' }]} />

  <section id="fonctions" class="modules modules--liens" aria-labelledby="fonctions-titre">
    <h2 class="offre__titre" id="fonctions-titre" data-reveal>Sept fonctions, une seule saisie</h2>
    <ul class="modules__list">
      {fonctions.map((p, i) => (
        <li data-reveal style={i ? `--i:${i}` : undefined}>
          <a href={lien(p.url)}><span class="modules__name">{noms[p.url]}</span><span class="modules__what">{p.resume}</span></a>
        </li>
      ))}
    </ul>
  </section>

  <section id="aussi" class="aussi" aria-labelledby="aussi-titre">
    <figure class="aussi__photo" data-reveal>
      <Photo nom="port-en-bessin" sizes="(max-width: 1080px) 100vw, 60vw" alt="Vue aérienne du port de Port-en-Bessin, en Normandie, au retour des bateaux de pêche" />
      <figcaption>Retour de pêche à Port-en-Bessin, dans le Calvados.</figcaption>
    </figure>
    <h2 class="aussi__titre titre-long" id="aussi-titre" data-reveal>Et aussi, dans le même abonnement</h2>
    <dl class="aussi__liste">
      {aussi.map(([dt, dd], i) => <div data-reveal style={`--i:${i % 4}`}><dt>{dt}</dt><dd>{dd}</dd></div>)}
    </dl>
    <p class="aussi__suite" data-reveal>Ce qui arrive ensuite dans C’Claires est sur la <a class="link" href={lien('/feuille-de-route/')}>feuille de route</a>. Le détail de l’offre est sur la page <a class="link" href={lien('/tarifs/')}>tarifs</a>.</p>
  </section>

  <AppelFinal titre="Qu’est-ce que vous faites encore à la main ?" texte="Dites-le-nous : en 30 minutes, nous vous montrons la fonction qui s’en charge, avec vos articles et vos clients." />
</Base>
