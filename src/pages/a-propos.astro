---
// À propos (requête : ACIGO Informatique). Seulement des faits connus ; la photo de l’équipe s’affiche une fois
// fournie (src/donnees/preuves.mjs).
import Base from '../layouts/Base.astro';
import EnTetePage from '../components/EnTetePage.astro';
import Photo from '../components/Photo.astro';
import AppelFinal from '../components/AppelFinal.astro';
import Telephone from '../components/Telephone.astro';
import { lien } from '../lib/chemins.mjs';
import { prechargePhoto } from '../lib/precharge.mjs';
import { equipe, pageClients } from '../donnees/preuves.mjs';

const url = '/a-propos/';
const tailleHero = '(max-width: 720px) 67vw, 33vw';
const precharge = await prechargePhoto('port-en-bessin', tailleHero);
---
<Base
  titre="ACIGO Informatique, éditeur depuis 1997"
  description="ACIGO Informatique, éditeur de logiciels à Saint-Lô depuis 1997, conçoit et maintient C’Claires : données hébergées en France, sauvegardes gérées par l’éditeur."
  url={url}
  enTete="accueil"
  precharges={[precharge]}
>
  <EnTetePage slot="avant" url={url} h1="Un éditeur normand depuis 1997" accroche={['Au téléphone,', 'qui décroche ?']} couleur="paon" photos={['port-en-bessin', 'bouchots-agon', 'claires-seudre']} tailleHero={tailleHero}
    sousTitre="L’équipe d’ACIGO Informatique, à Saint-Lô, dans la Manche. Depuis 1997, elle conçoit, édite et maintient C’Claires, et c’est elle qui vous répond."
    actions={[{ href: lien('/demo/'), texte: 'Réserver ma démo de 30 minutes', primaire: true }, equipe ? { href: '#equipe', texte: 'Rencontrer l’équipe' } : { href: '#donnees', texte: 'Où sont vos données' }]} />

  <section id="editeur" class="about" aria-labelledby="editeur-titre">
    <h2 class="about__title titre-long" id="editeur-titre" data-reveal>À Saint-Lô, près des parcs et des criées</h2>
    <div class="grid">
      <div class="about__lead" data-reveal style="--i:1">
        <p>Pas de plateforme d’appels ni de ticket qui attend&nbsp;: quand vous appelez, quelqu’un de l’équipe ACIGO décroche, à Saint-Lô. <Telephone class="link" /></p>
      </div>
    </div>
    <div class="grid about__tiles">
      <figure class="about__photo" data-reveal>
        <div class="shutter"><Photo nom="port-en-bessin" class="photo drift" sizes="(max-width: 1080px) 100vw, 66vw" alt="Vue aérienne du port de Port-en-Bessin, en Normandie, au retour des bateaux de pêche" /></div>
        <figcaption class="about__note">Port-en-Bessin, dans le Calvados, au retour de pêche.</figcaption>
      </figure>
      <div class="about__side">
        <div class="about__map" data-reveal style="--i:1"><img src={lien('/assets/img/carte-saint-lo.svg')} width="507" height="520" alt="Carte de France, Saint-Lô marqué dans la Manche" loading="lazy"></div>
        <dl class="facts" data-reveal style="--i:2">
          <div><dt>Siège</dt><dd>706 rue Dunant, Saint-Lô</dd></div>
          <div><dt>Fondée</dt><dd>14 octobre 1997</dd></div>
          <div><dt>Forme</dt><dd>SARL</dd></div>
          <div><dt>SIREN</dt><dd>414 125 674</dd></div>
        </dl>
      </div>
    </div>
  </section>

  {equipe && (
    <section id="equipe" class="benefices" aria-labelledby="equipe-titre">
      <h2 class="benefices__titre titre-long" id="equipe-titre" data-reveal>L’équipe</h2>
      <figure class="equipe" data-reveal>
        <Photo nom={equipe.photo} class="equipe__photo" sizes="(max-width: 1080px) 100vw, 64rem" alt="L’équipe ACIGO Informatique à Saint-Lô" />
        <figcaption>{equipe.legende}</figcaption>
      </figure>
    </section>
  )}

  <section id="donnees" class="aussi" aria-labelledby="donnees-titre">
    <h2 class="aussi__titre titre-long" id="donnees-titre" data-reveal>Vos données, hébergées en France</h2>
    <dl class="aussi__liste aussi__liste--deux">
      <div data-reveal><dt>Hébergées en France</dt><dd>Chez l’hébergeur Nat-Tech, sur un serveur central auquel chaque poste se connecte.</dd></div>
      <div data-reveal style="--i:1"><dt>Sauvegardées par l’éditeur</dt><dd>ACIGO gère lui-même les sauvegardes.</dd></div>
      <div data-reveal style="--i:2"><dt>Une base par entreprise</dt><dd>Chaque client a sa propre base, séparée de celles des autres.</dd></div>
      <div data-reveal style="--i:3"><dt>Du bureau au parc</dt><dd>Postes Windows ou serveur TSE, à vous de choisir, et la tablette Android au parc ; les étiquettes s’impriment en local, sur les étiqueteuses du poste.</dd></div>
    </dl>
    <p class="aussi__suite" data-reveal>Ce qui arrive ensuite dans le logiciel est sur la <a class="link" href={lien('/feuille-de-route/')}>feuille de route</a>{pageClients ? <>, et ceux qui l’utilisent sont sur la page <a class="link" href={lien('/clients/')}>clients</a></> : ''}.</p>
  </section>

  <AppelFinal texte="Faisons connaissance : en 30 minutes, nous vous montrons C’Claires avec vos articles et vos clients, et vous rencontrez l’équipe qui vous répondra ensuite." />
</Base>
