---
// Les documents que C’Claires tire de la commande d’exemple : un onglet par document, la feuille
// affichée à droite avec ce qu’elle couvre et le lien vers le guide ou la fonctionnalité liée
// (src/scripts/site.js). Sans script, tous les documents se suivent.
import { lien } from '../lib/chemins.mjs';
import Etiquette from './documents/Etiquette.astro';
import BonLivraison from './documents/BonLivraison.astro';
import FichePalette from './documents/FichePalette.astro';
import Tracabilite from './documents/Tracabilite.astro';
import Cerfa from './documents/Cerfa.astro';

interface Props { titre?: string; note?: string }
const {
  titre = 'Cinq documents, une seule saisie',
  note = 'Chaque document part de la même commande : mêmes lots, mêmes poids, mêmes numéros. Pas un chiffre qui diffère entre l’étiquette et la facture le jour du contrôle. Choisissez-en un pour le voir tel qu’il sort.',
} = Astro.props;

const documents = [
  { id: 'etiquette', nom: 'Étiquette sanitaire', Composant: Etiquette,
    mention: 'Marque d’identification, espèce, date de conditionnement, numéro de lot et zone de production.',
    lien: ['/guides/mentions-obligatoires-etiquette-sanitaire/', 'Les mentions obligatoires de l’étiquette sanitaire'] },
  { id: 'bl', nom: 'Bon de livraison', Composant: BonLivraison,
    mention: 'Pour chaque ligne : espèce, origine, méthode de production, lot et poids, repris de la commande.',
    lien: ['/fonctionnalites/commandes-bons-de-livraison/', 'Les commandes et les bons de livraison'] },
  { id: 'palette', nom: 'Fiche palette', Composant: FichePalette,
    mention: 'Le SSCC de la palette en code-barres GS1-128, sa composition et ses poids.',
    lien: ['/fonctionnalites/palettisation-sscc/', 'La palettisation et le SSCC'] },
  { id: 'trace', nom: 'Traçabilité du lot', Composant: Tracabilite,
    mention: 'Le lot remonté jusqu’à sa réception et suivi jusqu’à chaque client livré, dans les deux sens.',
    lien: ['/fonctionnalites/tracabilite/', 'La traçabilité des lots'] },
  { id: 'cerfa', nom: 'CERFA 15063', Composant: Cerfa,
    mention: 'Le document d’enregistrement des coquillages vivants, CERFA n° 15063*04, prérempli depuis le bon de livraison.',
    lien: ['/guides/cerfa-15063/', 'Remplir le CERFA 15063 sans erreur'] },
];
---
<section id="documents" class="docs" aria-labelledby="docs-titre">
  <h2 class="docs__titre titre-long" id="docs-titre" data-reveal>{titre}</h2>
  <div class="grid docs__grid">
    <div class="docs__index" role="tablist" aria-label="Documents de la commande C-26-01482">
      {documents.map((d, i) => (
        <button type="button" role="tab" id={`tab-${d.id}`} aria-controls={`doc-${d.id}`} aria-selected={String(i === 0)}
          tabindex={i === 0 ? undefined : '-1'} data-reveal style={i ? `--i:${i}` : undefined}>{d.nom}</button>
      ))}
      <p class="docs__note" data-reveal style={`--i:${documents.length}`}>{note}</p>
    </div>

    <div class="docs__stage" data-reveal style="--i:2">
      {documents.map(({ id, Composant, mention, lien: [cible, texte] }, i) => (
        <div class="docs__panneau" role="tabpanel" id={`doc-${id}`} aria-labelledby={`tab-${id}`} tabindex="0" hidden={i > 0}>
          <p class="docs__mention">{mention} <a class="link" href={lien(cible)}>{texte}</a></p>
          <Composant />
        </div>
      ))}
    </div>
  </div>
</section>
