---
// Un témoignage client, tiré de src/donnees/preuves.mjs : un vrai client qui a donné son accord écrit,
// jamais de citation, de nom ni d’entreprise inventés. La citation en <blockquote>, puis le nom,
// l’entreprise et le bassin en <figcaption>, avec la photo.
import Photo from './Photo.astro';

interface Props {
  t: { citation: string; prenom: string; nom: string; entreprise: string; bassin: string; photo?: string };
  class?: string;
}
const { t, class: classe = '' } = Astro.props;
---
<figure class:list={['temoignage', classe]} data-reveal>
  <blockquote class="temoignage__citation"><p>« {t.citation} »</p></blockquote>
  <figcaption class="temoignage__auteur">
    {t.photo && <span class="temoignage__vignette"><Photo nom={t.photo} alt="" sizes="4.5rem" widths={[144]} class="temoignage__photo" /></span>}
    <span><b>{t.prenom} {t.nom}</b>, {t.entreprise}<br>{t.bassin}</span>
  </figcaption>
</figure>
