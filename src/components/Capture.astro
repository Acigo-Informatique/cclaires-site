---
// Emplacement d’une capture d’écran du logiciel : un cadre au ratio de la future image, sa légende,
// et le texte alternatif déjà rédigé. Remplacer le cadre par l’image (dans src/assets/captures/)
// en reprenant ce même alt.
import ACompleter from './ACompleter.astro';

interface Props {
  id: string;           // ex. CAPT-01
  sujet: string;        // ce que la capture doit montrer
  alt: string;          // le texte alternatif de la future image
  legende: string;
  ratio?: string;       // largeur / hauteur, ex. '16 / 10'
  class?: string;
}
const { id, sujet, alt, legende, ratio = '16 / 10', class: classe = '' } = Astro.props;
---
<figure class:list={['capture', classe]} style={`--ratio: ${ratio}`}>
  <ACompleter id={id} class="capture__cadre" texte={`capture d’écran, ${sujet}. Texte alternatif à reprendre : « ${alt} »`} />
  <figcaption class="capture__legende">{legende}</figcaption>
</figure>
