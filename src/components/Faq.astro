---
// Questions : une bande par question, toutes les réponses visibles. Le même tableau nourrit le
// JSON-LD FAQPage de la page (questions() dans src/donnees/schemas.mjs) : ce qui est lu est ce qui est déclaré.
interface Props {
  questions: { q: string; r: string }[];   // r : HTML simple (paragraphes, liens)
  titre?: string;
  id?: string;
}
const { questions, titre = 'Vos questions', id = 'questions' } = Astro.props;
---
<section id={id} class="faq" aria-labelledby={`${id}-titre`}>
  <div class="faq__head"><h2 id={`${id}-titre`} data-reveal>{titre}</h2></div>
  <div class="faq__bands">
    {questions.map(({ q, r }) => (
      <div class="faq__band grid">
        <h3 class="faq__q" data-reveal set:html={q} />
        <div class="faq__a" data-reveal style="--i:1" set:html={r} />
      </div>
    ))}
  </div>
</section>
